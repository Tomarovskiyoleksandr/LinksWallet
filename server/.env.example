NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DB_MODE=postgres
DATABASE_URL=postgresql://linkswallet:change-me@127.0.0.1:5432/linkswallet
DATABASE_SSL=false
DB_POOL_MAX=10
SESSION_SECRET=replace-with-at-least-32-random-characters

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@example.com
SMTP_PASSWORD=replace-me
SMTP_FROM=LinksWallet <noreply@example.com>
